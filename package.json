{
  "name": "glorp",
  "productName": "Glorp",
  "version": "0.1.0",
  "description": "Glorp: a living desktop companion drawn entirely in code.",
  "private": true,
  "main": "dist/main/index.cjs",
  "author": "Glorp contributors",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lab": "vite --open /lab/index.html",
    "build": "vite build && node scripts/build-main.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "electron": "^44.7.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
}
